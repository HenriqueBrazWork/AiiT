from flask import Flask, request, jsonify
import torch
from transformers import GPT2LMHeadModel, GPT2Tokenizer

app = Flask(__name__)

# Carregar o modelo treinado
model_path = r"C:\Users\henri\Desktop\Work\LLMPT"
model = GPT2LMHeadModel.from_pretrained(model_path)
tokenizer = GPT2Tokenizer.from_pretrained(model_path)

# Garantir que o modelo use o dispositivo correto
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
model.to(device)

@app.route("/chat", methods=["POST"])
def chat():
    data = request.json
    user_input = data.get("input", "")

    if not user_input:
        return jsonify({"response": "Por favor, envie uma mensagem válida."})

    # Tokenizar entrada
    inputs = tokenizer.encode(user_input, return_tensors="pt").to(device)

    # Gerar resposta
    outputs = model.generate(inputs, max_length=50, num_return_sequences=1, pad_token_id=tokenizer.eos_token_id)
    response = tokenizer.decode(outputs[0], skip_special_tokens=True)

    return jsonify({"response": response})

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
