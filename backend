from flask import Flask, request, jsonify
from transformers import GPT2LMHeadModel, GPT2Tokenizer
import torch
from flask_cors import CORS

app = Flask(__name__)
CORS(app)

# Carregar o modelo GPT-2 da Hugging Face
model_name = "gpt2"  # Pode substituir por outro modelo como 'distilgpt2'
model = GPT2LMHeadModel.from_pretrained(model_name)
tokenizer = GPT2Tokenizer.from_pretrained(model_name)

# Garantir que o modelo use o dispositivo correto (GPU ou CPU)
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
model.to(device)

@app.route("/chat", methods=["POST"])
def chat():
    data = request.json
    user_input = data.get("input", "")

    if not user_input:
        return jsonify({"response": "Por favor, envie uma mensagem válida."})

    # Tokenizar entrada do usuário
    inputs = tokenizer.encode(user_input, return_tensors="pt").to(device)

    # Gerar resposta
    outputs = model.generate(
        inputs, 
        max_length=100, 
        num_return_sequences=1, 
        pad_token_id=tokenizer.eos_token_id,
        top_k=50,          # Restringe a amostra aos K tokens mais prováveis
        top_p=0.95,        # Nucleus sampling: mantém a probabilidade cumulativa de 95%
        temperature=0.7,   # Controla a criatividade (quanto mais baixo, mais previsível)
        no_repeat_ngram_size=2  # Impede a repetição de n-gramas
    )

    # Decodificar resposta gerada
    response = tokenizer.decode(outputs[0], skip_special_tokens=True)

    return jsonify({"response": response})

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
